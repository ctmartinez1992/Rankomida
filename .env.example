# Local development environment (copy to `.env` and adjust).
# Dokku/production: set these via platform config (e.g. `dokku config:set`).
# Values already in the process environment are never overridden by `.env`.

DEBUG=true
SECRET_KEY=django-insecure-local-dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=sqlite:////absolute/path/to/db.sqlite3
# CSRF_TRUSTED_ORIGINS=https://example.com

# Google reCAPTCHA v2 site/secret keys (required in production).
# Leave unset locally to use Google's published test keys (always pass).
# RECAPTCHA_PUBLIC_KEY=
# RECAPTCHA_PRIVATE_KEY=

# Google Maps Platform key with Places API (New) enabled.
# Only needed to run `manage.py import_google_places`; the site does not use it.
# GOOGLE_MAPS_API_KEY=
